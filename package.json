{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness Desktop — 基于官方 DeepSeek Harness Agent 框架的 Windows 原生桌面客户端",
  "license": "MIT",
  "author": "DSH Desktop",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "electron-vite dev --watch",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/rebuild-native.js",
    "rebuild:native": "node scripts/rebuild-native.js",
    "package": "npm run build && electron-builder --win nsis",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:all": "npm run build && electron-builder --win nsis portable",
    "gen:icon": "powershell -ExecutionPolicy Bypass -File scripts/generate-icon.ps1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DSH Desktop",
    "artifactName": "DSH-Desktop-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "uninstallDisplayName": "DSH Desktop",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "DSH-Desktop-${version}-portable-${arch}.${ext}"
    },
    "publish": null
  }
}
